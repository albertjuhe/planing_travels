{% extends 'old_base.html.twig' %}

{% block title %}Calendar – {{ travel.title }}{% endblock %}

{% block navbar %}
    {% include 'default/navbarPublic.html.twig' %}
{% endblock %}

{% block css %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/leaflet@1.7.1/leaflet.css') }}"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
    <style>
*, *::before, *::after { box-sizing: border-box; }

.cs-page {
    background: #f4f6f8;
    min-height: calc(100vh - 64px);
    padding-bottom: 60px;
}
.cs-page__inner {
    max-width: none;
    padding: 0 60px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* Header (same as pa-header) */
.pa-header {
    background: linear-gradient(135deg, #1a2e4a 0%, #2980b9 100%);
    padding: 36px 60px 32px;
    margin-bottom: 24px;
}
.pa-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
}
.pa-header__left {
    display: flex;
    align-items: center;
    gap: 16px;
}
.pa-header__icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #f39c12;
    color: #fff;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(255,255,255,0.25);
}
.pa-header__titles { display: flex; flex-direction: column; gap: 4px; }
.pa-header__back {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: rgba(255,255,255,0.6);
    font-size: 12px;
    text-decoration: none;
    transition: color 0.15s;
    margin-bottom: 2px;
}
.pa-header__back:hover { color: #fff; text-decoration: none; }
.pa-header__title {
    font-size: 26px;
    font-weight: 700;
    color: #fff;
    margin: 0;
    line-height: 1.2;
}
.pa-header__sub {
    font-size: 14px;
    color: rgba(255,255,255,0.75);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
}
.pa-header__sub strong { color: #fff; }
.pa-header__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
}
.pa-stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
}

/* Unscheduled */
.cs-unscheduled {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07), 0 8px 24px rgba(0,0,0,0.06);
    overflow: hidden;
    margin-bottom: 20px;
}
.cs-unscheduled__head {
    padding: 13px 18px;
    background: linear-gradient(135deg, #1a2e4a 0%, #2980b9 100%);
    font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.9);
    text-transform: uppercase; letter-spacing: 0.8px;
    display: flex; align-items: center; gap: 8px;
}
.cs-unscheduled__body {
    padding: 12px 16px;
    display: flex; flex-wrap: wrap; gap: 8px;
    min-height: 48px;
}
.cs-unscheduled__empty { font-size: 12px; color: #b0bec5; font-style: italic; }

/* Calendar grid */
.cs-grid {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07), 0 8px 24px rgba(0,0,0,0.06);
    overflow: hidden;
}
.cs-grid__head {
    padding: 14px 18px;
    background: linear-gradient(135deg, #1a2e4a 0%, #2574a9 100%);
    color: #fff; font-size: 14px; font-weight: 700;
    display: flex; align-items: center; gap: 8px;
}
.cs-month-label {
    padding: 8px 14px 6px;
    font-size: 12px; font-weight: 700; color: #2980b9;
    text-transform: uppercase; letter-spacing: 0.6px;
    background: #f0f7ff;
    border-top: 2px solid #d6eaf8;
    border-bottom: 1px solid #d6eaf8;
}

/* Day rows */
.cs-day {
    display: flex; align-items: center;
    border-bottom: 1px solid #eaecef;
    min-height: 48px;
    transition: background 0.1s;
}
.cs-day:last-child { border-bottom: none; }
.cs-day--weekend { background: #fdfaf5; }
.cs-day--today { background: #f0f7ff; }
.cs-day__head {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 14px; flex-shrink: 0; width: 160px;
}
.cs-day__dow {
    font-size: 11px; font-weight: 600; color: #7f8c8d;
    text-transform: uppercase; letter-spacing: 0.5px; width: 32px;
}
.cs-day--weekend .cs-day__dow { color: #e67e22; }
.cs-day__num {
    font-size: 14px; font-weight: 700; color: #2c3e50;
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
}
.cs-day--today .cs-day__num { background: #2980b9; color: #fff; font-size: 13px; }
.cs-day--weekend .cs-day__num { color: #e67e22; }
.cs-day__body {
    flex: 1; padding: 6px 8px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 5px; min-width: 0;
}

/* Add button */
.cs-add-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; border-radius: 50%; border: none;
    background: #e8f4fd; color: #2980b9;
    cursor: pointer; font-size: 16px; line-height: 1;
    transition: background 0.15s, color 0.15s, transform 0.1s;
    flex-shrink: 0; padding: 0;
}
.cs-add-btn:hover { background: #2980b9; color: #fff; transform: scale(1.15); }

/* Location cards */
.cs-card {
    display: flex; align-items: flex-start; gap: 5px;
    padding: 4px 8px; border-radius: 6px;
    border-left: 3px solid #2980b9; background: #eaf4fd;
    font-size: 12px; color: #1a2e4a; position: relative;
    transition: background 0.12s;
}
.cs-card:hover { background: #d6eaf8; }
.cs-card__icon { flex-shrink: 0; font-size: 11px; line-height: 1.4; opacity: 0.75; }
.cs-card__text { flex: 1; min-width: 0; }
.cs-card__title { font-weight: 600; line-height: 1.3; word-break: break-word; }
.cs-card__type { font-size: 9px; color: #5d8aa8; margin-top: 1px; text-transform: uppercase; letter-spacing: 0.3px; }
.cs-card__times { display: flex; align-items: center; gap: 4px; margin-top: 3px; }
.cs-remove-btn {
    flex-shrink: 0; background: none; border: none;
    color: #a8c8e0; font-size: 13px; line-height: 1;
    cursor: pointer; padding: 0; border-radius: 3px;
    transition: color 0.12s; align-self: flex-start; margin-top: 1px;
}
.cs-remove-btn:hover { color: #e74c3c; }

/* Time inputs */
.cs-time-input {
    font-size: 11px; border: 1px solid #dde3ea; border-radius: 5px;
    padding: 2px 4px; color: #2c3e50; background: #fff;
    cursor: pointer; width: 80px; transition: border-color 0.15s;
}
.cs-time-input:focus { border-color: #2980b9; outline: none; }
.cs-time-sep { font-size: 11px; color: #9ca3af; }
.cs-time-badge {
    font-size: 11px; background: #eaf4fd; color: #1a2e4a;
    border-radius: 4px; padding: 2px 6px; font-weight: 600;
}

/* Unscheduled card */
.cs-unscheduled .cs-card {
    font-size: 12px; padding: 7px 9px; border-radius: 8px;
    border-left-width: 4px; background: #f4f6f8;
    border-color: #b0bec5; color: #2c3e50;
}
.cs-unscheduled .cs-card:hover { background: #eaecef; }

/* Picker dropdown */
.cs-picker {
    position: fixed; z-index: 3000;
    background: #fff; border: 1px solid #dde3ea;
    border-radius: 12px; box-shadow: 0 12px 36px rgba(0,0,0,0.18);
    min-width: 210px; max-width: 270px;
    max-height: min(300px, calc(100vh - 16px));
    overflow-y: auto; padding: 6px; display: none;
}
.cs-picker.is-open { display: block; }
.cs-picker__empty { font-size: 12px; color: #b0bec5; text-align: center; padding: 16px 8px; }
.cs-picker__item {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 10px; border-radius: 7px;
    font-size: 12px; color: #2c3e50; cursor: pointer; transition: background 0.12s;
}
.cs-picker__item:hover { background: #eaf4fd; }
.cs-picker__item__icon { flex-shrink: 0; font-size: 13px; }
.cs-picker__item__title { font-weight: 600; line-height: 1.3; }
.cs-picker__item__type { font-size: 10px; color: #95a5a6; }

/* Type accent colours */
.cs-card[data-icon*="bed"]       { border-color: #8e44ad; background: #f5eef8; }
.cs-card[data-icon*="plane"]     { border-color: #27ae60; background: #eafaf1; }
.cs-card[data-icon*="camera"]    { border-color: #e67e22; background: #fef9e7; }
.cs-card[data-icon*="cutlery"]   { border-color: #e74c3c; background: #fdedec; }
.cs-card[data-icon*="train"]     { border-color: #16a085; background: #e8f8f5; }
.cs-card[data-icon*="bus"]       { border-color: #d35400; background: #fdf2e9; }
.cs-card[data-icon*="coffee"]    { border-color: #795548; background: #efebe9; }

/* Layout: calendar + map side by side */
.cs-layout {
    display: flex;
    gap: 20px;
    align-items: flex-start;
}
.cs-left { flex: 1; min-width: 0; }
.cs-right { flex: 1; min-width: 0; position: sticky; top: 20px; }

/* Map panel */
.cs-map {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07), 0 8px 24px rgba(0,0,0,0.06);
    overflow: hidden;
}
.cs-map__head {
    padding: 14px 18px;
    background: linear-gradient(135deg, #1a2e4a 0%, #2574a9 100%);
    color: #fff;
    display: flex; align-items: center; justify-content: space-between;
}
.cs-map__title {
    font-size: 14px; font-weight: 700;
    display: flex; align-items: center; gap: 8px;
}
.cs-map__btns { display: flex; gap: 6px; }
.cs-map-btn {
    padding: 6px 14px; font-size: 12px; font-weight: 600;
    border: 1px solid rgba(255,255,255,0.3); border-radius: 8px;
    background: rgba(255,255,255,0.1); color: #fff;
    cursor: pointer; transition: all 0.15s; white-space: nowrap;
}
.cs-map-btn:hover { background: rgba(255,255,255,0.2); }
.cs-map-btn.is-active { background: #fff; color: #1a2e4a; border-color: #fff; }
#cs-cal-map { height: 500px; }

/* Legend */
.cs-legend {
    padding: 12px 18px; border-top: 1px solid #eaecef;
    display: flex; flex-wrap: wrap; gap: 12px;
    font-size: 12px; color: #636e72;
}
.cs-legend__item { display: flex; align-items: center; gap: 5px; }
.cs-legend__dot {
    width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
}
.cs-map-info {
    padding: 8px 18px 12px; font-size: 12px; color: #7f8c8d;
}

/* Responsive */
@media (max-width: 1200px) {
    .cs-layout { flex-direction: column; }
    .cs-right { position: relative; top: 0; }
}

@media (max-width: 991px) {
    .pa-header { padding: 28px 20px 24px; }
    .cs-page__inner { padding: 0 20px; }
    .pa-header__title { font-size: 22px; }
    .pa-header__icon { width: 44px; height: 44px; font-size: 18px; }
    .cs-day__head { width: 120px; padding: 8px 10px; }
    #cs-cal-map { height: 400px; }
}

@media (max-width: 600px) {
    .pa-header { padding: 24px 16px 20px; }
    .cs-page__inner { padding: 0 16px; }
    .pa-header__inner { flex-direction: column; align-items: flex-start; }
    .pa-header__right { width: 100%; justify-content: flex-start; }
    .pa-header__title { font-size: 20px; }
    .pa-header__icon { width: 40px; height: 40px; font-size: 16px; }
    .cs-day { flex-direction: column; align-items: flex-start; }
    .cs-day__head { width: 100%; border-bottom: 1px solid #eaecef; }
    .cs-day__body { width: 100%; padding: 8px 10px; }
    #cs-cal-map { height: 300px; }
    .cs-map__btns { flex-wrap: wrap; }
}
    </style>
{% endblock %}

{% block content %}
{% set isOwner = app.user is not null and app.user.userId == travel.user.userId %}
{% set canEdit = isOwner or (app.user is not null and travel.sharedusers|filter(u => u.userId == app.user.userId)|length > 0) %}

<div class="cs-page">

    {# Header #}
    <div class="pa-header">
        <div class="pa-header__inner">
            <div class="pa-header__left">
                <div class="pa-header__icon">✈</div>
                <div class="pa-header__titles">
                    <a href="{{ path('homepage') }}" class="pa-header__back">
                        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3L5 8l5 5"/></svg>
                        Home
                    </a>
                    <h1 class="pa-header__title">{{ travel.title }}</h1>
                    <p class="pa-header__sub">
                        {% if travel.description %}
                            <span>{{ travel.description }}</span>
                        {% endif %}
                        <span class="pa-header__meta-item">
                            <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor"><path d="M11 1v1H5V1H3v1H1v13h14V2h-2V1h-2zm2 12H3V6h10v7z"/></svg>
                            {{ travel.startAt|date("d M Y") }} – {{ travel.endAt|date("d M Y") }}
                        </span>
                        <span class="pa-header__meta-item">
                            By <strong>{{ travel.user.firstName }} {{ travel.user.lastName }}</strong>
                        </span>
                    </p>
                </div>
            </div>
            <div class="pa-header__right">
                <span class="pa-stat-pill">
                    <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor"><path d="M8 1l1.8 3.6L14 5.3l-3 2.9.7 4.1L8 10.4l-3.7 1.9.7-4.1-3-2.9 4.2-.7z"/></svg>
                    {{ travel.stars }}
                </span>
                <span class="pa-stat-pill">
                    <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor"><path d="M8 3C4.5 3 1.5 6 1 8c.5 2 3.5 5 7 5s6.5-3 7-5c-.5-2-3.5-5-7-5zm0 8a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0-5a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/></svg>
                    {{ travel.watch }}
                </span>
            </div>
        </div>
    </div>

    <div class="cs-page__inner">
        {% include 'travel/viewTabs.html.twig' with {'travel': travel, 'active': 'calendar'} %}

        <div class="cs-layout">
            <div class="cs-left">

        {# Unscheduled locations #}
    <div class="cs-unscheduled">
        <div class="cs-unscheduled__head">
            <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor"><path d="M8 1a5 5 0 0 1 5 5c0 4-5 9-5 9S3 10 3 6a5 5 0 0 1 5-5zm0 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/></svg>
            Unscheduled locations
        </div>
        <div class="cs-unscheduled__body" id="cs-unscheduled">
            {% set hasUnscheduled = false %}
            {% for loc in travel.location %}
                {% if not loc.hasAnyVisitDate %}
                    {% set hasUnscheduled = true %}
                    <div class="cs-card" id="cs-loc-{{ loc.id }}"
                         data-location-id="{{ loc.id }}"
                         data-title="{{ loc.title|e('html_attr') }}"
                         data-type="{{ loc.typeLocation is not null ? loc.typeLocation.title|e('html_attr') : '' }}"
                         data-icon="{{ loc.typeLocation is not null ? loc.typeLocation.icon|e('html_attr') : '' }}">
                        <span class="cs-card__icon">
                            {% if loc.typeLocation is not null %}<i class="{{ loc.typeLocation.icon }}"></i>{% else %}📍{% endif %}
                        </span>
                        <span class="cs-card__text">
                            <div class="cs-card__title">{{ loc.title }}</div>
                            {% if loc.typeLocation is not null %}<div class="cs-card__type">{{ loc.typeLocation.title }}</div>{% endif %}
                        </span>
                    </div>
                {% endif %}
            {% endfor %}
            {% if not hasUnscheduled %}
                <span class="cs-unscheduled__empty">All locations scheduled ✓</span>
            {% endif %}
        </div>
    </div>

    {# Calendar grid #}
    <div class="cs-grid">
        <div class="cs-grid__head">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M11 1v1H5V1H3v1H1v13h14V2h-2V1h-2zm2 12H3V6h10v7z"/></svg>
            {{ travel.startAt|date("d M Y") }} – {{ travel.endAt|date("d M Y") }}
        </div>

        {% set startTs   = travel.startAt|date('U') %}
        {% set endTs     = travel.endAt|date('U') %}
        {% set tripDays  = (((endTs - startTs) / 86400)|round(0,'ceil') + 1) %}
        {% set dowNames  = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'] %}
        {% set monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'] %}
        {% set todayStr  = 'now'|date('Y-m-d') %}
        {% set lastMonth = '' %}

        {% for i in 0..tripDays-1 %}
            {% set thisDate    = travel.startAt|date_modify('+' ~ i ~ ' days') %}
            {% set thisDateStr = thisDate|date('Y-m-d') %}
            {% set dow         = thisDate|date('N') %}
            {% set isWeekend   = dow >= 6 %}
            {% set isToday     = thisDateStr == todayStr %}
            {% set thisMonth   = thisDate|date('Y-n') %}

            {% if thisMonth != lastMonth %}
                {% set lastMonth = thisMonth %}
                <div class="cs-month-label">{{ monthNames[thisDate|date('n') - 1] }} {{ thisDate|date('Y') }}</div>
            {% endif %}

            <div class="cs-day{% if isWeekend %} cs-day--weekend{% endif %}{% if isToday %} cs-day--today{% endif %}"
                 id="cs-day-{{ thisDateStr }}"
                 data-date="{{ thisDateStr }}">
                <div class="cs-day__head">
                    <span class="cs-day__dow">{{ dowNames[dow - 1] }}</span>
                    <span class="cs-day__num">{{ thisDate|date('d') }}</span>
                    {% if canEdit %}
                    <button class="cs-add-btn" type="button" data-date="{{ thisDateStr }}" title="Add location">+</button>
                    {% endif %}
                </div>
                <div class="cs-day__body">
                    {% for loc in travel.getLocationsForDate(thisDateStr) %}
                        {% set vd = null %}
                        {% for v in loc.visitDates %}
                            {% if v.visitDateString == thisDateStr %}{% set vd = v %}{% endif %}
                        {% endfor %}
                        <div class="cs-card" id="cs-loc-{{ loc.id }}-{{ thisDateStr }}"
                             data-location-id="{{ loc.id }}"
                             data-date="{{ thisDateStr }}"
                             data-title="{{ loc.title|e('html_attr') }}"
                             data-type="{{ loc.typeLocation is not null ? loc.typeLocation.title|e('html_attr') : '' }}"
                             data-icon="{{ loc.typeLocation is not null ? loc.typeLocation.icon|e('html_attr') : '' }}">
                            <span class="cs-card__icon">
                                {% if loc.typeLocation is not null %}<i class="{{ loc.typeLocation.icon }}"></i>{% else %}📍{% endif %}
                            </span>
                            <span class="cs-card__text">
                                <div class="cs-card__title">{{ loc.title }}</div>
                                {% if loc.typeLocation is not null %}<div class="cs-card__type">{{ loc.typeLocation.title }}</div>{% endif %}
                                <div class="cs-card__times">
                                    {% if canEdit %}
                                    <input type="time" class="cs-time-input cs-time-start"
                                           value="{{ vd and vd.timeStartString ? vd.timeStartString : '' }}"
                                           data-location-id="{{ loc.id }}"
                                           data-date="{{ thisDateStr }}"
                                           title="Start time">
                                    <span class="cs-time-sep">→</span>
                                    <input type="time" class="cs-time-input cs-time-end"
                                           value="{{ vd and vd.timeEndString ? vd.timeEndString : '' }}"
                                           data-location-id="{{ loc.id }}"
                                           data-date="{{ thisDateStr }}"
                                           title="End time">
                                    {% elseif vd and vd.timeStartString %}
                                    <span class="cs-time-badge">{{ vd.timeStartString }}{% if vd.timeEndString %} – {{ vd.timeEndString }}{% endif %}</span>
                                    {% endif %}
                                </div>
                            </span>
                            {% if canEdit %}
                            <button class="cs-remove-btn" type="button"
                                    data-location-id="{{ loc.id }}"
                                    data-date="{{ thisDateStr }}"
                                    title="Remove from this day">×</button>
                            {% endif %}
                        </div>
                    {% endfor %}
                    {% for gpx in travel.gpx %}
                        {% if gpx.visitDateString == thisDateStr %}
                        <a class="cs-card cs-card--gpx" href="{{ path('show_travel', {slug: travel.slug}) }}#gpx-{{ gpx.id }}"
                           style="border-color:{{ gpx.color }};background:{{ gpx.color }}1a;color:#1a2e4a;text-decoration:none;"
                           data-gpx-id="{{ gpx.id }}" title="{{ gpx.title|default(gpx.filename) }}">
                            <span class="cs-card__icon">
                                <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="{{ gpx.color }}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12L4 6l3 4 2-3 3 5 2-3"/></svg>
                            </span>
                            <span class="cs-card__text">
                                <div class="cs-card__title">{{ gpx.title|default(gpx.filename) }}</div>
                                <div class="cs-card__type" style="color:{{ gpx.color }};">GPX track{% if gpx.distance %} · {{ (gpx.distance / 1000)|number_format(2) }} km{% endif %}</div>
                            </span>
                        </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>

            </div>
            
            <div class="cs-right">
                <div class="cs-map">
                    <div class="cs-map__head">
                        <span class="cs-map__title">
                            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 1a5 5 0 0 1 5 5c0 4-5 9-5 9S3 10 3 6a5 5 0 0 1 5-5zm0 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/></svg>
                            Locations Map
                        </span>
                        <div class="cs-map__btns">
                            <button class="cs-map-btn is-active" id="cs-btn-all" type="button">All locations</button>
                            <button class="cs-map-btn" id="cs-btn-day" type="button" disabled>Select a day</button>
                        </div>
                    </div>
                    <div id="cs-cal-map"></div>
                    <div class="cs-legend" id="cs-legend"></div>
                    <div class="cs-map-info" id="cs-map-info">Click a day on the calendar to filter</div>
                </div>
            </div>
        </div>

    </div>
</div>

{# Picker dropdown #}
{% if canEdit %}
<div class="cs-picker" id="cs-picker">
    <div class="cs-picker__empty" id="cs-picker-empty">No unscheduled locations</div>
</div>
{% endif %}

{% include 'travel/weatherWidget.html.twig' with { 'travel': travel, 'canViewWeather': canEdit, 'daySelector': '.cs-day[data-date]', 'locationSelector': '.cs-card[data-date]' } %}

{% endblock %}

{% block javascript %}
    {{ parent() }}
    <script src="{{ asset('js/leaflet@1.7.1/leaflet.js') }}"></script>
    {% set isOwner = app.user is not null and app.user.userId == travel.user.userId %}
    {% set canEdit = isOwner or (app.user is not null and travel.sharedusers|filter(u => u.userId == app.user.userId)|length > 0) %}
    <script>
    (function () {
        var VISIT_DATE_URL = '{{ path('updateLocationVisitDate', {'locationId': '__LOC__'}) }}';
        var VISIT_TIME_URL = '{{ path('updateVisitTime', {'locationId': '__LOC__'}) }}';
        var CAN_EDIT = {{ canEdit ? 'true' : 'false' }};
        var COLORS = ['#e74c3c','#2980b9','#27ae60','#8e44ad','#f39c12','#1abc9c','#d35400','#c0392b','#2c3e50','#16a085'];

        var ALL_LOCATIONS = [
            {% for loc in travel.location %}
            {
                id: '{{ loc.id }}',
                title: {{ loc.title|json_encode|raw }},
                type: {{ (loc.typeLocation is not null ? loc.typeLocation.title : '')|json_encode|raw }},
                icon: {{ (loc.typeLocation is not null ? loc.typeLocation.icon : '')|json_encode|raw }},
                lat: {{ loc.mark is not null and loc.mark.geolocation is not null ? loc.mark.geolocation.lat : 'null' }},
                lng: {{ loc.mark is not null and loc.mark.geolocation is not null ? loc.mark.geolocation.lng : 'null' }},
                visitDates: [
                    {% for vd in loc.visitDates %}
                    '{{ vd.visitDateString }}'{% if not loop.last %},{% endif %}
                    {% endfor %}
                ]
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ];

        /* ── Time inputs ── */
        if (CAN_EDIT) {
            var saveTimer = {};
            document.querySelectorAll('.cs-time-input').forEach(function (input) {
                input.addEventListener('change', function () {
                    var locationId = input.dataset.locationId;
                    var date = input.dataset.date;
                    var key = locationId + '|' + date;
                    clearTimeout(saveTimer[key]);
                    saveTimer[key] = setTimeout(function () {
                        var card = input.closest('.cs-card');
                        var startInput = card.querySelector('.cs-time-start');
                        var endInput = card.querySelector('.cs-time-end');
                        fetch(VISIT_TIME_URL.replace('__LOC__', locationId), {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                date: date,
                                timeStart: startInput ? startInput.value : null,
                                timeEnd: endInput ? endInput.value : null
                            })
                        }).catch(function () {});
                    }, 600);
                });
            });

            /* ── Remove from day ── */
            document.querySelectorAll('.cs-remove-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var locationId = btn.dataset.locationId;
                    var date = btn.dataset.date;
                    fetch(VISIT_DATE_URL.replace('__LOC__', locationId), {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ action: 'remove', date: date })
                    }).then(function (r) {
                        if (r.ok) {
                            var card = document.getElementById('cs-loc-' + locationId + '-' + date);
                            if (card) card.remove();
                            /* move to unscheduled if no more dates */
                            fetch(VISIT_DATE_URL.replace('__LOC__', locationId).replace('PATCH', 'GET'));
                            location.reload();
                        }
                    }).catch(function () {});
                });
            });

            /* ── Add location picker ── */
            var picker = document.getElementById('cs-picker');
            var activeDateBtn = null;

            function buildPickerItems() {
                var date = activeDateBtn ? activeDateBtn.dataset.date : null;
                /* collect location IDs already on this day */
                var alreadyOnDay = {};
                if (date) {
                    var dayEl = document.getElementById('cs-day-' + date);
                    if (dayEl) {
                        dayEl.querySelectorAll('.cs-card[data-location-id]').forEach(function (c) {
                            alreadyOnDay[c.dataset.locationId] = true;
                        });
                    }
                }
                picker.innerHTML = '';
                var available = ALL_LOCATIONS.filter(function (loc) {
                    return !alreadyOnDay[loc.id];
                });
                if (!available.length) {
                    picker.innerHTML = '<div class="cs-picker__empty">No locations to add</div>';
                    return;
                }
                available.forEach(function (loc) {
                    var item = document.createElement('div');
                    item.className = 'cs-picker__item';
                    item.dataset.locationId = loc.id;
                    var icon = loc.icon ? '<i class="' + loc.icon + ' cs-picker__item__icon"></i>' : '<span class="cs-picker__item__icon">📍</span>';
                    item.innerHTML = icon +
                        '<span><div class="cs-picker__item__title">' + loc.title + '</div>' +
                        (loc.type ? '<div class="cs-picker__item__type">' + loc.type + '</div>' : '') + '</span>';
                    item.addEventListener('click', function () {
                        var d = activeDateBtn ? activeDateBtn.dataset.date : null;
                        if (!d) return;
                        fetch(VISIT_DATE_URL.replace('__LOC__', loc.id), {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                            body: JSON.stringify({ action: 'add', date: d })
                        }).then(function (r) {
                            if (r.ok) { picker.classList.remove('is-open'); location.reload(); }
                        }).catch(function () {});
                    });
                    picker.appendChild(item);
                });
            }

            document.querySelectorAll('.cs-add-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    activeDateBtn = btn;
                    buildPickerItems();
                    picker.style.top = '';
                    picker.style.bottom = '';
                    picker.style.left = '';
                    picker.classList.add('is-open');
                    var rect = btn.getBoundingClientRect();
                    var pickerH = picker.offsetHeight;
                    var spaceBelow = window.innerHeight - rect.bottom;
                    var spaceAbove = rect.top;
                    if (spaceBelow >= pickerH + 8 || spaceBelow >= spaceAbove) {
                        picker.style.top = (rect.bottom + 4) + 'px';
                    } else {
                        picker.style.top = Math.max(4, rect.top - pickerH - 4) + 'px';
                    }
                    var left = rect.left;
                    if (left + 270 > window.innerWidth) {
                        left = Math.max(4, window.innerWidth - 274);
                    }
                    picker.style.left = left + 'px';
                });
            });

            document.addEventListener('click', function () {
                picker.classList.remove('is-open');
            });
        }

        /* ── Map logic ── */
        var calMap = L.map('cs-cal-map', {
            center: [{{ travel.geolocation.lat }}, {{ travel.geolocation.lng }}],
            zoom: 7,
            attributionControl: false
        });
        L.tileLayer('http://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
            maxZoom: 20,
            subdomains: ['mt0','mt1','mt2','mt3']
        }).addTo(calMap);

        var markersLayer = L.layerGroup().addTo(calMap);
        var infoEl = document.getElementById('cs-map-info');
        var legendEl = document.getElementById('cs-legend');
        var btnAll = document.getElementById('cs-btn-all');
        var btnDay = document.getElementById('cs-btn-day');
        var selectedDay = null;

        function clearMap() {
            markersLayer.clearLayers();
            legendEl.innerHTML = '';
        }

        function getLocationsByDay() {
            var byDay = {};
            var unscheduled = [];
            ALL_LOCATIONS.forEach(function (loc) {
                if (loc.lat === null || loc.lng === null) return;
                if (loc.visitDates.length === 0) {
                    unscheduled.push(loc);
                } else {
                    loc.visitDates.forEach(function (date) {
                        if (!byDay[date]) byDay[date] = [];
                        byDay[date].push(loc);
                    });
                }
            });
            return { byDay: byDay, unscheduled: unscheduled };
        }

        function addMarker(loc, color, isUnscheduled) {
            var ll = [loc.lat, loc.lng];
            var options = {
                radius: isUnscheduled ? 12 : 9,
                fillColor: color,
                color: isUnscheduled ? '#95a5a6' : '#fff',
                weight: isUnscheduled ? 3 : 2.5,
                fillOpacity: isUnscheduled ? 0.6 : 0.9,
                dashArray: isUnscheduled ? '6, 4' : null
            };
            var m = L.circleMarker(ll, options);
            
            var popupContent = '<strong>' + loc.title + '</strong>' + 
                (loc.type ? '<br><small>' + loc.type + '</small>' : '');
            
            if (isUnscheduled && CAN_EDIT) {
                popupContent += '<br><br><button type="button" class="cs-assign-btn" data-location-id="' + loc.id + 
                    '" style="padding:4px 12px;background:#2980b9;color:#fff;border:none;border-radius:4px;cursor:pointer;">' +
                    '📅 Assign to day</button>';
            } else if (loc.visitDates.length > 0) {
                popupContent += '<br><small style="color:#7f8c8d;">📅 ' + loc.visitDates.join(', ') + '</small>';
            }
            
            m.bindPopup(popupContent);
            m.on('popupopen', function () {
                var assignBtn = document.querySelector('.cs-assign-btn[data-location-id="' + loc.id + '"]');
                if (assignBtn) {
                    assignBtn.addEventListener('click', function (e) {
                        e.stopPropagation();
                        m.closePopup();
                        openPickerForLocation(loc.id);
                    });
                }
            });
            
            markersLayer.addLayer(m);
            return ll;
        }

        function openPickerForLocation(locationId) {
            var loc = ALL_LOCATIONS.find(function (l) { return l.id == locationId; });
            if (!loc) return;
            
            var picker = document.getElementById('cs-picker');
            if (!picker) return;
            
            picker.innerHTML = '';
            var dates = [];
            {% set startTs   = travel.startAt|date('U') %}
            {% set endTs     = travel.endAt|date('U') %}
            {% set tripDays  = (((endTs - startTs) / 86400)|round(0,'ceil') + 1) %}
            {% for i in 0..tripDays-1 %}
                {% set thisDate = travel.startAt|date_modify('+' ~ i ~ ' days') %}
                dates.push('{{ thisDate|date('Y-m-d') }}');
            {% endfor %}
            
            dates.forEach(function (date) {
                var item = document.createElement('div');
                item.className = 'cs-picker__item';
                item.innerHTML = '<strong>' + date + '</strong><br><small style="color:#7f8c8d;">Click to assign ' + loc.title + '</small>';
                item.addEventListener('click', function () {
                    fetch(VISIT_DATE_URL.replace('__LOC__', locationId), {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ action: 'add', date: date })
                    }).then(function (r) {
                        if (r.ok) { location.reload(); }
                    }).catch(function () {});
                });
                picker.appendChild(item);
            });
            
            picker.classList.add('is-open');
            picker.style.left = '50%';
            picker.style.top = '50%';
            picker.style.transform = 'translate(-50%, -50%)';
            
            setTimeout(function () {
                function closeOnClick(e) {
                    if (!picker.contains(e.target)) {
                        picker.classList.remove('is-open');
                        picker.style.transform = 'none';
                        document.removeEventListener('click', closeOnClick);
                    }
                }
                document.addEventListener('click', closeOnClick);
            }, 10);
        }

        function updateLegend(byDay, colors, unscheduledCount) {
            var keys = Object.keys(byDay);
            var html = '';
            if (unscheduledCount > 0) {
                html += '<span class="cs-legend__item"><span class="cs-legend__dot" style="background:#95a5a6;border:2px dashed #bdc3c7;"></span>' +
                    ' Unscheduled (' + unscheduledCount + ')</span>';
            }
            html += keys.map(function (d, i) {
                return '<span class="cs-legend__item"><span class="cs-legend__dot" style="background:' +
                    colors[i % colors.length] + '"></span>' + d + ' (' + byDay[d].length + ')</span>';
            }).join('');
            legendEl.innerHTML = html;
        }

        function renderAllLocations() {
            clearMap();
            var data = getLocationsByDay();
            var byDay = data.byDay;
            var unscheduled = data.unscheduled;
            var dates = Object.keys(byDay);
            
            var allBounds = [];
            
            unscheduled.forEach(function (loc) {
                var ll = addMarker(loc, '#95a5a6', true);
                allBounds.push(ll);
            });
            
            dates.forEach(function (date, i) {
                var color = COLORS[i % COLORS.length];
                byDay[date].forEach(function (loc) {
                    var ll = addMarker(loc, color, false);
                    allBounds.push(ll);
                });
            });
            
            if (allBounds.length > 0) {
                calMap.fitBounds(allBounds, { padding: [40, 40] });
            }
            
            var totalWithCoords = ALL_LOCATIONS.filter(function (l) { return l.lat !== null; }).length;
            infoEl.textContent = 
                '📍 ' + unscheduled.length + ' unscheduled · ' +
                dates.length + ' days · ' +
                totalWithCoords + ' locations on map';
            
            updateLegend(byDay, COLORS, unscheduled.length);
        }

        function renderDayLocations(date) {
            clearMap();
            var data = getLocationsByDay();
            var byDay = data.byDay;
            var unscheduled = data.unscheduled;
            
            var allBounds = [];
            
            unscheduled.forEach(function (loc) {
                var ll = addMarker(loc, '#95a5a6', true);
                allBounds.push(ll);
            });
            
            if (byDay[date] && byDay[date].length > 0) {
                byDay[date].forEach(function (loc) {
                    var ll = addMarker(loc, '#2980b9', false);
                    allBounds.push(ll);
                });
            }
            
            if (allBounds.length > 0) {
                calMap.fitBounds(allBounds, { padding: [50, 50] });
            }
            
            var dayCount = byDay[date] ? byDay[date].length : 0;
            infoEl.textContent = 
                '📍 ' + date + ' · ' + dayCount + ' location' + (dayCount !== 1 ? 's' : '') +
                ' · Still ' + unscheduled.length + ' unscheduled';
            
            var singleDay = {};
            if (dayCount > 0) singleDay[date] = byDay[date];
            updateLegend(singleDay, ['#2980b9'], unscheduled.length);
        }

        function setActiveBtn(btn) {
            [btnAll, btnDay].forEach(function (b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
        }

        /* Day click */
        document.querySelectorAll('.cs-day').forEach(function (dayEl) {
            dayEl.addEventListener('click', function (e) {
                if (e.target.closest('.cs-add-btn') || e.target.closest('.cs-card')) return;
                document.querySelectorAll('.cs-day.cs-day--selected').forEach(function (d) {
                    d.classList.remove('cs-day--selected');
                });
                dayEl.classList.add('cs-day--selected');
                selectedDay = dayEl.dataset.date;
                setActiveBtn(btnDay);
                btnDay.textContent = selectedDay;
                btnDay.disabled = false;
                renderDayLocations(selectedDay);
            });
        });

        btnAll.addEventListener('click', function () {
            selectedDay = null;
            setActiveBtn(btnAll);
            btnDay.textContent = 'Select a day';
            btnDay.disabled = true;
            document.querySelectorAll('.cs-day.cs-day--selected').forEach(function (d) {
                d.classList.remove('cs-day--selected');
            });
            renderAllLocations();
        });

        /* Click on unscheduled card in list */
        document.querySelectorAll('#cs-unscheduled .cs-card').forEach(function (card) {
            card.style.cursor = 'pointer';
            card.addEventListener('click', function () {
                var locId = card.dataset.locationId;
                if (locId && CAN_EDIT) {
                    openPickerForLocation(locId);
                }
            });
        });

        /* Initial render */
        renderAllLocations();

        /* Add selected day styles */
        var style = document.createElement('style');
        style.textContent = '.cs-day--selected { background: #eaf4fd !important; outline: 2px solid #2980b9; outline-offset: -2px; } ' +
            '.cs-legend__dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }';
        document.head.appendChild(style);

    }());
    </script>
{% endblock %}

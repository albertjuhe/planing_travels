</div>
{% endif %}

{% include 'travel/weatherWidget.html.twig' with { 'travel': travel, 'canViewWeather': canEdit, 'daySelector': '.cs-day[data-date]', 'locationSelector': '.cs-card[data-date]' } %}

{% endblock %}

{% block javascript %}
    {{ parent() }}
    <script src="{{ asset('js/leaflet@1.7.1/leaflet.js') }}"></script>
    {% set isOwner = app.user is not null and app.user.userId == travel.user.userId %}
    {% set canEdit = isOwner or (app.user is not null and travel.sharedusers|filter(u => u.userId == app.user.userId)|length > 0) %}
    <script>
    (function () {
        var VISIT_DATE_URL = '{{ path('updateLocationVisitDate', {'locationId': '__LOC__'}) }}';
        var VISIT_TIME_URL = '{{ path('updateVisitTime', {'locationId': '__LOC__'}) }}';
        var CAN_EDIT = {{ canEdit ? 'true' : 'false' }};
        var COLORS = ['#e74c3c','#2980b9','#27ae60','#8e44ad','#f39c12','#1abc9c','#d35400','#c0392b','#2c3e50','#16a085'];

        var ALL_LOCATIONS = [
            {% for loc in travel.location %}
            {
                id: '{{ loc.id }}',
                title: {{ loc.title|json_encode|raw }},
                type: {{ (loc.typeLocation is not null ? loc.typeLocation.title : '')|json_encode|raw }},
                icon: {{ (loc.typeLocation is not null ? loc.typeLocation.icon : '')|json_encode|raw }},
                lat: {{ loc.mark is not null and loc.mark.geolocation is not null ? loc.mark.geolocation.lat : 'null' }},
                lng: {{ loc.mark is not null and loc.mark.geolocation is not null ? loc.mark.geolocation.lng : 'null' }},
                visitDates: [
                    {% for vd in loc.visitDates %}
                    '{{ vd.visitDateString }}'{% if not loop.last %},{% endif %}
                    {% endfor %}
                ]
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ];

        /* ── Time inputs ── */
        if (CAN_EDIT) {
            var saveTimer = {};
            document.querySelectorAll('.cs-time-input').forEach(function (input) {
                input.addEventListener('change', function () {
                    var locationId = input.dataset.locationId;
                    var date = input.dataset.date;
                    var key = locationId + '|' + date;
                    clearTimeout(saveTimer[key]);
                    saveTimer[key] = setTimeout(function () {
                        var card = input.closest('.cs-card');
                        var startInput = card.querySelector('.cs-time-start');
                        var endInput = card.querySelector('.cs-time-end');
                        fetch(VISIT_TIME_URL.replace('__LOC__', locationId), {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                date: date,
                                timeStart: startInput ? startInput.value : null,
                                timeEnd: endInput ? endInput.value : null
                            })
                        }).catch(function () {});
                    }, 600);
                });
            });

            /* ── Remove from day ── */
            document.querySelectorAll('.cs-remove-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var locationId = btn.dataset.locationId;
                    var date = btn.dataset.date;
                    fetch(VISIT_DATE_URL.replace('__LOC__', locationId), {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ action: 'remove', date: date })
                    }).then(function (r) {
                        if (r.ok) {
                            var card = document.getElementById('cs-loc-' + locationId + '-' + date);
                            if (card) card.remove();
                            /* move to unscheduled if no more dates */
                            fetch(VISIT_DATE_URL.replace('__LOC__', locationId).replace('PATCH', 'GET'));
                            location.reload();
                        }
                    }).catch(function () {});
                });
            });

            /* ── Add location picker ── */
            var picker = document.getElementById('cs-picker');
            var activeDateBtn = null;

            function buildPickerItems() {
                var date = activeDateBtn ? activeDateBtn.dataset.date : null;
                /* collect location IDs already on this day */
                var alreadyOnDay = {};
                if (date) {
                    var dayEl = document.getElementById('cs-day-' + date);
                    if (dayEl) {
                        dayEl.querySelectorAll('.cs-card[data-location-id]').forEach(function (c) {
                            alreadyOnDay[c.dataset.locationId] = true;
                        });
                    }
                }
                picker.innerHTML = '';
                var available = ALL_LOCATIONS.filter(function (loc) {
                    return !alreadyOnDay[loc.id];
                });
                if (!available.length) {
                    picker.innerHTML = '<div class="cs-picker__empty">No locations to add</div>';
                    return;
                }
                available.forEach(function (loc) {
                    var item = document.createElement('div');
                    item.className = 'cs-picker__item';
                    item.dataset.locationId = loc.id;
                    var icon = loc.icon ? '<i class="' + loc.icon + ' cs-picker__item__icon"></i>' : '<span class="cs-picker__item__icon">📍</span>';
                    item.innerHTML = icon +
                        '<span><div class="cs-picker__item__title">' + loc.title + '</div>' +
                        (loc.type ? '<div class="cs-picker__item__type">' + loc.type + '</div>' : '') + '</span>';
                    item.addEventListener('click', function () {
                        var d = activeDateBtn ? activeDateBtn.dataset.date : null;
                        if (!d) return;
                        fetch(VISIT_DATE_URL.replace('__LOC__', loc.id), {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                            body: JSON.stringify({ action: 'add', date: d })
                        }).then(function (r) {
                            if (r.ok) { picker.classList.remove('is-open'); location.reload(); }
                        }).catch(function () {});
                    });
                    picker.appendChild(item);
                });
            }

            document.querySelectorAll('.cs-add-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    activeDateBtn = btn;
                    buildPickerItems();
                    picker.style.top = '';
                    picker.style.bottom = '';
                    picker.style.left = '';
                    picker.classList.add('is-open');
                    var rect = btn.getBoundingClientRect();
                    var pickerH = picker.offsetHeight;
                    var spaceBelow = window.innerHeight - rect.bottom;
                    var spaceAbove = rect.top;
                    if (spaceBelow >= pickerH + 8 || spaceBelow >= spaceAbove) {
                        picker.style.top = (rect.bottom + 4) + 'px';
                    } else {
                        picker.style.top = Math.max(4, rect.top - pickerH - 4) + 'px';
                    }
                    var left = rect.left;
                    if (left + 270 > window.innerWidth) {
                        left = Math.max(4, window.innerWidth - 274);
                    }
                    picker.style.left = left + 'px';
                });
            });

            document.addEventListener('click', function () {
                picker.classList.remove('is-open');
            });
        }

        /* ── Map logic ── */
        var calMap = L.map('cs-cal-map', {
            center: [{{ travel.geolocation.lat }}, {{ travel.geolocation.lng }}],
            zoom: 7,
            attributionControl: false
        });
        L.tileLayer('http://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
            maxZoom: 20,
            subdomains: ['mt0','mt1','mt2','mt3']
        }).addTo(calMap);

        var markersLayer = L.layerGroup().addTo(calMap);
        var infoEl = document.getElementById('cs-map-info');
        var legendEl = document.getElementById('cs-legend');
        var btnAll = document.getElementById('cs-btn-all');
        var btnDay = document.getElementById('cs-btn-day');
        var selectedDay = null;

        function clearMap() {
            markersLayer.clearLayers();
            legendEl.innerHTML = '';
        }

        function getLocationsByDay() {
            var byDay = {};
            var unscheduled = [];
            ALL_LOCATIONS.forEach(function (loc) {
                if (loc.lat === null || loc.lng === null) return;
                if (loc.visitDates.length === 0) {
                    unscheduled.push(loc);
                } else {
                    loc.visitDates.forEach(function (date) {
                        if (!byDay[date]) byDay[date] = [];
                        byDay[date].push(loc);
                    });
                }
            });
            return { byDay: byDay, unscheduled: unscheduled };
        }

        function addMarker(loc, color, isUnscheduled) {
            var ll = [loc.lat, loc.lng];
            var options = {
                radius: isUnscheduled ? 12 : 9,
                fillColor: color,
                color: isUnscheduled ? '#95a5a6' : '#fff',
                weight: isUnscheduled ? 3 : 2.5,
                fillOpacity: isUnscheduled ? 0.6 : 0.9,
                dashArray: isUnscheduled ? '6, 4' : null
            };
            var m = L.circleMarker(ll, options);
            
            var popupContent = '<strong>' + loc.title + '</strong>' + 
                (loc.type ? '<br><small>' + loc.type + '</small>' : '');
            
            if (isUnscheduled && CAN_EDIT) {
                popupContent += '<br><br><button type="button" class="cs-assign-btn" data-location-id="' + loc.id + 
                    '" style="padding:4px 12px;background:#2980b9;color:#fff;border:none;border-radius:4px;cursor:pointer;">' +
                    '📅 Assign to day</button>';
            } else if (loc.visitDates.length > 0) {
                popupContent += '<br><small style="color:#7f8c8d;">📅 ' + loc.visitDates.join(', ') + '</small>';
            }
            
            m.bindPopup(popupContent);
            m.on('popupopen', function () {
                var assignBtn = document.querySelector('.cs-assign-btn[data-location-id="' + loc.id + '"]');
                if (assignBtn) {
                    assignBtn.addEventListener('click', function (e) {
                        e.stopPropagation();
                        m.closePopup();
                        openPickerForLocation(loc.id);
                    });
                }
            });
            
            markersLayer.addLayer(m);
            return ll;
        }

        function openPickerForLocation(locationId) {
            var loc = ALL_LOCATIONS.find(function (l) { return l.id == locationId; });
            if (!loc) return;
            
            var picker = document.getElementById('cs-picker');
            if (!picker) return;
            
            picker.innerHTML = '';
            var dates = [];
            {% set startTs   = travel.startAt|date('U') %}
            {% set endTs     = travel.endAt|date('U') %}
            {% set tripDays  = (((endTs - startTs) / 86400)|round(0,'ceil') + 1) %}
            {% for i in 0..tripDays-1 %}
                {% set thisDate = travel.startAt|date_modify('+' ~ i ~ ' days') %}
                dates.push('{{ thisDate|date('Y-m-d') }}');
            {% endfor %}
            
            dates.forEach(function (date) {
                var item = document.createElement('div');
                item.className = 'cs-picker__item';
                item.innerHTML = '<strong>' + date + '</strong><br><small style="color:#7f8c8d;">Click to assign ' + loc.title + '</small>';
                item.addEventListener('click', function () {
                    fetch(VISIT_DATE_URL.replace('__LOC__', locationId), {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ action: 'add', date: date })
                    }).then(function (r) {
                        if (r.ok) { location.reload(); }
                    }).catch(function () {});
                });
                picker.appendChild(item);
            });
            
            picker.classList.add('is-open');
            picker.style.left = '50%';
            picker.style.top = '50%';
            picker.style.transform = 'translate(-50%, -50%)';
            
            setTimeout(function () {
                function closeOnClick(e) {
                    if (!picker.contains(e.target)) {
                        picker.classList.remove('is-open');
                        picker.style.transform = 'none';
                        document.removeEventListener('click', closeOnClick);
                    }
                }
                document.addEventListener('click', closeOnClick);
            }, 10);
        }

        function updateLegend(byDay, colors, unscheduledCount) {
            var keys = Object.keys(byDay);
            var html = '';
            if (unscheduledCount > 0) {
                html += '<span class="cs-legend__item"><span class="cs-legend__dot" style="background:#95a5a6;border:2px dashed #bdc3c7;"></span>' +
                    ' Unscheduled (' + unscheduledCount + ')</span>';
            }
            html += keys.map(function (d, i) {
                return '<span class="cs-legend__item"><span class="cs-legend__dot" style="background:' +
                    colors[i % colors.length] + '"></span>' + d + ' (' + byDay[d].length + ')</span>';
            }).join('');
            legendEl.innerHTML = html;
        }

        function renderAllLocations() {
            clearMap();
            var data = getLocationsByDay();
            var byDay = data.byDay;
            var unscheduled = data.unscheduled;
            var dates = Object.keys(byDay);
            
            var allBounds = [];
            
            unscheduled.forEach(function (loc) {
                var ll = addMarker(loc, '#95a5a6', true);
                allBounds.push(ll);
            });
            
            dates.forEach(function (date, i) {
                var color = COLORS[i % COLORS.length];
                byDay[date].forEach(function (loc) {
                    var ll = addMarker(loc, color, false);
                    allBounds.push(ll);
                });
            });
            
            if (allBounds.length > 0) {
                calMap.fitBounds(allBounds, { padding: [40, 40] });
            }
            
            var totalWithCoords = ALL_LOCATIONS.filter(function (l) { return l.lat !== null; }).length;
            infoEl.textContent = 
                '📍 ' + unscheduled.length + ' unscheduled · ' +
                dates.length + ' days · ' +
                totalWithCoords + ' locations on map';
            
            updateLegend(byDay, COLORS, unscheduled.length);
        }

        function renderDayLocations(date) {
            clearMap();
            var data = getLocationsByDay();
            var byDay = data.byDay;
            var unscheduled = data.unscheduled;
            
            var allBounds = [];
            
            unscheduled.forEach(function (loc) {
                var ll = addMarker(loc, '#95a5a6', true);
                allBounds.push(ll);
            });
            
            if (byDay[date] && byDay[date].length > 0) {
                byDay[date].forEach(function (loc) {
                    var ll = addMarker(loc, '#2980b9', false);
                    allBounds.push(ll);
                });
            }
            
            if (allBounds.length > 0) {
                calMap.fitBounds(allBounds, { padding: [50, 50] });
            }
            
            var dayCount = byDay[date] ? byDay[date].length : 0;
            infoEl.textContent = 
                '📍 ' + date + ' · ' + dayCount + ' location' + (dayCount !== 1 ? 's' : '') +
                ' · Still ' + unscheduled.length + ' unscheduled';
            
            var singleDay = {};
            if (dayCount > 0) singleDay[date] = byDay[date];
            updateLegend(singleDay, ['#2980b9'], unscheduled.length);
        }

        function setActiveBtn(btn) {
            [btnAll, btnDay].forEach(function (b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
        }

        /* Day click */
        document.querySelectorAll('.cs-day').forEach(function (dayEl) {
            dayEl.addEventListener('click', function (e) {
                if (e.target.closest('.cs-add-btn') || e.target.closest('.cs-card')) return;
                document.querySelectorAll('.cs-day.cs-day--selected').forEach(function (d) {
                    d.classList.remove('cs-day--selected');
                });
                dayEl.classList.add('cs-day--selected');
                selectedDay = dayEl.dataset.date;
                setActiveBtn(btnDay);
                btnDay.textContent = selectedDay;
                btnDay.disabled = false;
                renderDayLocations(selectedDay);
            });
        });

        btnAll.addEventListener('click', function () {
            selectedDay = null;
            setActiveBtn(btnAll);
            btnDay.textContent = 'Select a day';
            btnDay.disabled = true;
            document.querySelectorAll('.cs-day.cs-day--selected').forEach(function (d) {
                d.classList.remove('cs-day--selected');
            });
            renderAllLocations();
        });

        /* Click on unscheduled card in list */
        document.querySelectorAll('#cs-unscheduled .cs-card').forEach(function (card) {
            card.style.cursor = 'pointer';
            card.addEventListener('click', function () {
                var locId = card.dataset.locationId;
                if (locId && CAN_EDIT) {
                    openPickerForLocation(locId);
                }
            });
        });

        /* Initial render */
        renderAllLocations();

        /* Add selected day styles */
        var style = document.createElement('style');
        style.textContent = '.cs-day--selected { background: #eaf4fd !important; outline: 2px solid #2980b9; outline-offset: -2px; } ' +
            '.cs-legend__dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }';
        document.head.appendChild(style);

        /* ============================================================
           AI ITINERARY GENERATOR
           ============================================================ */

        var currentItineraryResult = null;

        var prefsModal = document.getElementById('cs-ai-prefs-modal');
        var resultModal = document.getElementById('cs-ai-result-modal');
        var optimizeBtn = document.getElementById('cs-optimize-btn');
        var aiSpinner = document.getElementById('cs-ai-spinner');
        var aiBtnText = document.getElementById('cs-ai-btn-text');

        var SUGGEST_ITINERARY_URL = '{{ path('suggest_itinerary', {'slug': travel.slug}) }}';
        var VISIT_DATE_BASE = '{{ path('updateLocationVisitDate', {'locationId': '__LOC__'}) }}';

        function openModal(modal) {
            if (modal) modal.classList.add('is-open');
        }

        function closeModal(modal) {
            if (modal) modal.classList.remove('is-open');
        }

        if (optimizeBtn) {
            optimizeBtn.addEventListener('click', function () {
                openModal(prefsModal);
            });
        }

        var prefsClose = document.getElementById('cs-ai-prefs-close');
        var prefsCancel = document.getElementById('cs-ai-prefs-cancel');
        if (prefsClose) prefsClose.addEventListener('click', function () { closeModal(prefsModal); });
        if (prefsCancel) prefsCancel.addEventListener('click', function () { closeModal(prefsModal); });

        var resultClose = document.getElementById('cs-ai-result-close');
        if (resultClose) resultClose.addEventListener('click', function () { closeModal(resultModal); });

        prefsModal.addEventListener('click', function (e) {
            if (e.target === prefsModal) closeModal(prefsModal);
        });
        resultModal.addEventListener('click', function (e) {
            if (e.target === resultModal) closeModal(resultModal);
        });

        var generateBtn = document.getElementById('cs-ai-generate');
        if (generateBtn) {
            generateBtn.addEventListener('click', async function () {
                var maxPerDay = parseInt(document.getElementById('cs-ai-max-per-day').value);
                var startTime = document.getElementById('cs-ai-start-time').value;
                var noEarly = document.getElementById('cs-ai-no-early').checked;

                generateBtn.disabled = true;
                generateBtn.innerHTML = '⏳ Generating...';

                var resultBody = document.getElementById('cs-ai-result-body');
                resultBody.innerHTML =
                    '<div class="cs-ai-loading">' +
                    '<div class="cs-ai-loading__spinner"></div>' +
                    '<p>AI is analyzing your locations and optimizing the itinerary...</p>' +
                    '<p style="margin-top:8px;font-size:11px;">This may take 10-30 seconds</p>' +
                    '</div>';

                var resultTitle = document.getElementById('cs-ai-result-title');
                resultTitle.textContent = '🤖 Generating...';

                closeModal(prefsModal);
                openModal(resultModal);

                try {
                    var response = await fetch(SUGGEST_ITINERARY_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            maxPerDay: maxPerDay,
                            startTime: startTime,
                            noEarlyMornings: noEarly
                        })
                    });

                    if (!response.ok) {
                        var errText = await response.text();
                        throw new Error('API returned ' + response.status + ': ' + errText);
                    }

                    var result = await response.json();
                    currentItineraryResult = result;

                    renderItineraryResult(result);

                } catch (err) {
                    console.error('[ItineraryAI] Error:', err);
                    
                    var errorDetails = '';
                    var errorData = {};
                    try {
                        if (err.message && err.message.indexOf('{') !== -1) {
                            var jsonStart = err.message.indexOf('{');
                            var jsonStr = err.message.substring(jsonStart);
                            errorData = JSON.parse(jsonStr);
                        }
                    } catch (e) {}
                    
                    var backend = errorData.backend || 'ollama';
                    var hint = errorData.hint || '';
                    var message = errorData.message || err.message;
                    
                    if (backend === 'ollama') {
                        errorDetails =
                            '<div style="margin-top:12px;padding:16px;background:#fef9e7;border-left:3px solid #f39c12;border-radius:6px;">' +
                            '<h4 style="margin:0 0 8px;color:#936000;">🦙 Ollama Setup Required</h4>' +
                            '<ol style="margin:0;padding-left:20px;color:#7f6000;font-size:12px;line-height:1.6;">' +
                            '<li><strong>Install Ollama:</strong> <code style="background:#fff;padding:2px 6px;border-radius:3px;">curl -fsSL https://ollama.com/install.sh | sh</code></li>' +
                            '<li><strong>Pull a model:</strong> <code style="background:#fff;padding:2px 6px;border-radius:3px;">ollama pull llama3</code></li>' +
                            '<li><strong>Start Ollama:</strong> <code style="background:#fff;padding:2px 6px;border-radius:3px;">ollama serve</code></li>' +
                            '</ol>' +
                            (hint ? '<p style="margin:8px 0 0 0;font-size:11px;">💡 ' + hint + '</p>' : '') +
                            '</div>';
                    } else {
                        errorDetails =
                            '<div style="margin-top:12px;padding:12px;background:#e8f8f5;border-left:3px solid #27ae60;border-radius:6px;">' +
                            '<p style="margin:0;color:#186a3b;font-size:12px;">💡 Using OpenAI backend. Make sure <strong>OPENAI_API_KEY</strong> is configured in your <strong>.env</strong> file.</p>' +
                            (hint ? '<p style="margin:6px 0 0 0;font-size:11px;">' + hint + '</p>' : '') +
                            '</div>';
                    }
                    
                    resultBody.innerHTML =
                        '<div style="padding:40px 20px;text-align:center;">' +
                        '<div style="font-size:48px;margin-bottom:16px;">❌</div>' +
                        '<h3 style="margin:0 0 8px;color:#c0392b;">Failed to generate itinerary</h3>' +
                        '<p style="margin:0 0 12px;color:#7f8c8d;font-size:13px;">' + message + '</p>' +
                        '<p style="margin:0;font-size:12px;color:#95a5a6;">' +
                        'Backend: <strong>' + backend + '</strong>' +
                        '</p>' +
                        errorDetails +
                        '</div>';

                    resultTitle.textContent = '❌ Error';
                    var resultFooter = document.getElementById('cs-ai-result-footer');
                    resultFooter.innerHTML =
                        '<button class="cs-ai-btn-primary cs-ai-btn-secondary" onclick="document.getElementById(\'cs-ai-result-close\').click();" type="button">Close</button>';
                } finally {
                    generateBtn.disabled = false;
                    generateBtn.innerHTML = '✨ Generate Itinerary';
                }
            });
        }

        function renderItineraryResult(result) {
            var resultBody = document.getElementById('cs-ai-result-body');
            var resultTitle = document.getElementById('cs-ai-result-title');
            var resultFooter = document.getElementById('cs-ai-result-footer');

            resultTitle.textContent = '✨ ' + (result.summary || 'Suggested Itinerary');

            var html = '';

            var newCount = 0;
            if (result.days && result.days.length > 0) {
                result.days.forEach(function (day) {
                    if (day.locations && day.locations.length > 0) {
                        day.locations.forEach(function (loc) {
                            if (!loc.wasAlreadyScheduled) newCount++;
                        });
                    }
                });
            }

            html += '<div class="cs-ai-summary">';
            html += '<p><strong>' + (result.locationsAssigned || 0) + '</strong> locations will be assigned. ';
            if (newCount > 0) {
                html += '<strong>' + newCount + '</strong> new assignments, ';
            }
            html += '<strong>' + (result.locationsScheduled || 0) + '</strong> already scheduled.</p>';
            html += '</div>';

            if (result.days && result.days.length > 0) {
                result.days.forEach(function (day) {
                    html += '<div class="cs-ai-day">';
                    html += '<div class="cs-ai-day__head">';
                    html += '<h4 class="cs-ai-day__title">📅 ' + (day.title || day.date) + '</h4>';
                    html += '<span class="cs-ai-day__count">' +
                        (day.locations ? day.locations.length : 0) + ' locations</span>';
                    html += '</div>';
                    html += '<div class="cs-ai-day__body">';

                    if (day.locations && day.locations.length > 0) {
                        day.locations.forEach(function (loc) {
                            html += '<div class="cs-ai-loc">';
                            html += '<span class="cs-ai-loc__time">' + (loc.suggestedTime || '--:--') + '</span>';
                            html += '<div class="cs-ai-loc__main">';
                            html += '<div class="cs-ai-loc__title">' +
                                (loc.title || 'Unknown') +
                                (loc.wasAlreadyScheduled ?
                                    '<span class="cs-ai-loc__scheduled" style="margin-left:8px;">✓ Already scheduled</span>' :
                                    '<span class="cs-ai-loc__new" style="margin-left:8px;">New</span>') +
                                '</div>';
                            if (loc.reason) {
                                html += '<div class="cs-ai-loc__reason">💡 ' + loc.reason + '</div>';
                            }
                            html += '</div>';
                            html += '</div>';
                        });
                    } else {
                        html += '<div style="padding:12px;color:#95a5a6;font-size:13px;">No locations this day</div>';
                    }

                    html += '</div></div>';
                });
            }

            if (result.warnings && result.warnings.length > 0) {
                html += '<div class="cs-ai-warnings">';
                result.warnings.forEach(function (w) {
                    html += '<div class="cs-ai-warning">⚠️ ' + w + '</div>';
                });
                html += '</div>';
            }

            resultBody.innerHTML = html;

            var hasNewAssignments = false;
            if (result.days && result.days.length > 0) {
                result.days.forEach(function (day) {
                    if (day.locations && day.locations.length > 0) {
                        day.locations.forEach(function (loc) {
                            if (!loc.wasAlreadyScheduled && loc.id && loc.date) {
                                hasNewAssignments = true;
                            }
                        });
                    }
                });
            }

            resultFooter.innerHTML = '';

            var closeBtn = document.createElement('button');
            closeBtn.className = 'cs-ai-btn-primary cs-ai-btn-secondary';
            closeBtn.type = 'button';
            closeBtn.textContent = 'Close';
            closeBtn.addEventListener('click', function () { closeModal(resultModal); });
            resultFooter.appendChild(closeBtn);

            if (hasNewAssignments) {
                var applyBtn = document.createElement('button');
                applyBtn.className = 'cs-ai-btn-primary';
                applyBtn.type = 'button';
                applyBtn.innerHTML = '✅ Apply Itinerary';
                applyBtn.addEventListener('click', applyItinerary);
                resultFooter.appendChild(applyBtn);
            }
        }

        async function applyItinerary() {
            if (!currentItineraryResult) return;

            var resultFooter = document.getElementById('cs-ai-result-footer');
            var buttons = resultFooter.querySelectorAll('button');
            buttons.forEach(function (btn) {
                btn.disabled = true;
                if (btn.innerHTML.indexOf('Apply') !== -1) {
                    btn.innerHTML = '⏳ Applying...';
                }
            });

            var assignments = [];
            if (currentItineraryResult.days && currentItineraryResult.days.length > 0) {
                currentItineraryResult.days.forEach(function (day) {
                    if (day.locations && day.locations.length > 0) {
                        day.locations.forEach(function (loc) {
                            if (!loc.wasAlreadyScheduled && loc.id && loc.date) {
                                assignments.push({
                                    locationId: loc.id,
                                    date: loc.date,
                                    position: loc.position || 0
                                });
                            }
                        });
                    }
                });
            }

            if (assignments.length === 0) {
                buttons.forEach(function (btn) {
                    btn.disabled = false;
                    if (btn.innerHTML.indexOf('Apply') !== -1) {
                        btn.innerHTML = '✅ Apply Itinerary';
                    }
                });
                return;
            }

            var errors = [];
            var successCount = 0;

            for (var i = 0; i < assignments.length; i++) {
                var a = assignments[i];
                try {
                    var response = await fetch(VISIT_DATE_BASE.replace('__LOC__', a.locationId), {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            action: 'add',
                            date: a.date
                        })
                    });

                    if (response.ok) {
                        successCount++;
                    } else {
                        var errText = await response.text();
                        errors.push('Location ' + a.locationId + ': ' + errText);
                    }
                } catch (err) {
                    errors.push('Location ' + a.locationId + ': ' + err.message);
                }
            }

            closeModal(resultModal);

            if (successCount === assignments.length) {
                alert('✅ Itinerary applied successfully! (' + successCount + ' locations assigned)');
            } else if (successCount > 0) {
                alert('⚠️ Partially applied: ' + successCount + '/' + assignments.length +
                    ' locations.\\n\\nErrors:\\n' + errors.join('\\n'));
            } else {
                alert('❌ Failed to apply itinerary.\\n\\nErrors:\\n' + errors.join('\\n'));
            }

            location.reload();
        }

    }());
    </script>
{% endblock %}

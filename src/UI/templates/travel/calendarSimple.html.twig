            <h3 class="cs-ai-modal__title" id="cs-ai-result-title">✨ Suggested Itinerary</h3>
            <button class="cs-ai-modal__close" id="cs-ai-result-close">&times;</button>
        </div>
        <div class="cs-ai-modal__body" id="cs-ai-result-body">
        </div>
        <div class="cs-ai-modal__footer" id="cs-ai-result-footer">
        </div>
